# Set correct MIME types FIRST before any rewrite rules
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType application/javascript .mjs
  AddType text/css .css
  AddType application/json .json
  AddType image/svg+xml .svg
  AddType image/png .png
  AddType image/jpeg .jpg .jpeg
  AddType image/webp .webp
  AddType font/woff .woff
  AddType font/woff2 .woff2
  AddType font/ttf .ttf
  AddType font/eot .eot
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /frontend/

  # Don't rewrite actual files/folders
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # If request is under /frontend/assets and file is missing, keep 404
  RewriteCond %{REQUEST_URI} ^/frontend/assets/ [NC]
  RewriteRule ^ - [L]

  # Rewrite everything else to index.html for Vue Router
  RewriteRule ^ index.html [L]
</IfModule>

# Disable directory browsing
Options -Indexes

# Enable CORS for assets
<IfModule mod_headers.c>
  <FilesMatch "\.(js|mjs|css|json|svg|png|jpg|jpeg|webp|woff|woff2|ttf|eot)$">
    Header set Access-Control-Allow-Origin "*"
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>

# Set default charset
AddDefaultCharset UTF-8
